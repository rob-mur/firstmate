#!/usr/bin/env bash
# PROTOTYPE - throwaway. Terminal view of the bearings board.
# Starts the TUI: prototype/tui-board/run [app.py args]
# Fetches Python + Textual through nix on first start (cached afterwards).
set -eu
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
script=${TUI_BOARD_SCRIPT:-$here/app.py}
NIX_PATH= exec nix shell --impure --quiet --expr \
  'let p = (builtins.getFlake "nixpkgs").legacyPackages.${builtins.currentSystem}; in p.python3.withPackages (ps: [ ps.textual ])' \
  --command python3 -I "$script" "$@"
