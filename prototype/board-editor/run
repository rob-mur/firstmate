#!/usr/bin/env python3
"""PROTOTYPE - throwaway. The captain's calls as a folder of files for the editor.

    prototype/board-editor/run              open the board listing in ${EDITOR:-nvim}
    prototype/board-editor/run <card-key>   open one card on its own

Reads every captain call from bin/fm-captain-calls.sh (read-only) for the home
in TUI_BOARD_HOME (default /home/rob/repos/firstmate), or from a saved copy of
its JSON in TUI_BOARD_CALLS_JSON. Writes prototype/board/: board.md lists every
call, one line each, then the settled items to close; cards/<key>.md holds one
card. To open a card, press Enter (or gf) anywhere on its line in board.md:
when the editor is nvim or vim, the run maps both keys in that buffer only to
open the card in a NEW TAB, so :q (or :wq) on the card closes its tab and
returns to board.md. In another editor use <C-w>gf on the line, or
:tabedit cards/<key>.md. Move call lines in board.md to reorder; write an answer at the
bottom of a card file. When the editor exits, a new order and every answer are
appended to prototype/outbox.jsonl ONLY; nothing reaches the board, its
priority file, the backlog or a worker. Standard library only.
"""

from __future__ import annotations

import difflib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import textwrap
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
CALLS_SCRIPT = HERE.parent.parent / "bin" / "fm-captain-calls.sh"
HOME = os.environ.get("TUI_BOARD_HOME", "/home/rob/repos/firstmate")
SAVED = os.environ.get("TUI_BOARD_CALLS_JSON")
OUTBOX = Path(os.environ.get("TUI_BOARD_OUTBOX", str(HERE.parent / "outbox.jsonl")))
BOARD = HERE.parent / "board"
WIDTH = 78
LETTERS = "abcdefghijklmnopqrstuvwxyz"
CARD_LINE = re.compile(r"(?:^|[\s(])cards/([^\s)]+)\.md\b")


def load_model() -> dict:
    if SAVED:
        return json.loads(Path(SAVED).read_text())
    print(f"Reading the captain calls of {HOME} ...", file=sys.stderr)
    env = {**os.environ, "FM_HOME": HOME}
    for k in ("FM_ROOT_OVERRIDE", "FM_STATE_OVERRIDE", "FM_DATA_OVERRIDE"):
        env.pop(k, None)
    proc = subprocess.run([str(CALLS_SCRIPT)], env=env, capture_output=True, text=True)
    if proc.returncode != 0:
        raise SystemExit(f"fm-captain-calls.sh failed (exit {proc.returncode}):\n{proc.stderr.strip()}")
    return json.loads(proc.stdout)


def wrap(text: str, indent: str = "", rest: str | None = None) -> list[str]:
    text = re.sub(r"\s+", " ", text or "").strip()
    return textwrap.wrap(text, WIDTH, initial_indent=indent, subsequent_indent=indent if rest is None else rest,
                         break_long_words=False, break_on_hyphens=False) or [indent.rstrip()]


def question(card: dict) -> str:
    return card.get("question") or card.get("title") or card["key"]


def headline(card: dict, limit: int = 110) -> str:
    """The asking sentence: up to the first '?', else the first sentence, kept short."""
    q = re.sub(r"\s+", " ", question(card)).strip()
    m = re.match(r"(.+?\?)(\s|$)", q) or re.match(r"(.+?[.!])(\s|$)", q)
    head = m.group(1) if m else q
    return head if len(head) <= limit else head[: limit - 3].rstrip() + "..."


def origin(card: dict) -> str:
    if card.get("source") == "main-hold":
        return "main backlog"
    if card.get("source") == "main-worker":
        return f"main worker {card.get('task')}"
    return f"secondmate {card.get('home')}" + (" (remote)" if card.get("remote") else "")


def board_line(card: dict) -> str:
    repo = f"  [{card['repo']}]" if card.get("repo") else ""
    home = {"main-hold": "", "main-worker": "  (main worker)"}.get(card.get("source"), f"  ({card.get('home')})")
    return f"cards/{card['key']}.md  {headline(card)}{repo}{home}"


def render_board(model: dict) -> list[str]:
    calls, to_close = model.get("calls") or [], model.get("to_close") or []
    built = (model.get("generated") or "")[11:16]
    n = len(calls)
    out = [
        f"# Captain's calls: {n} call{'s' if n != 1 else ''}" + (f" (built {built}Z)" if built else ""),
        "",
        "One call per line, in board order. Move a line to reorder it (dd, then p).",
        "Open a card: press Enter (or gf) anywhere on its line. It opens in a new tab;",
        "in the card, :wq (or :q) closes the tab and brings you back here. gt / gT switch tabs.",
        "(Enter and gf are set up for nvim and vim. In another editor: <C-w>gf, or :tabedit cards/<key>.md.)",
        "Write answers at the bottom of the card files. When done, save all and quit: :wqa",
        "To send nothing at all, quit with :qa!",
        "",
        "PROTOTYPE: the order and answers are written only to prototype/outbox.jsonl.",
        "",
    ]
    hours = model.get("work_hours") or {}
    held = [s for s in model.get("skipped") or [] if "work hours" in s.get("why", "")]
    if hours.get("open") is False:
        out += [f"Outside work hours: {len(held)} work item{'s' if len(held) != 1 else ''} held until work hours (under Not calls now).", ""]
    out += [board_line(c) for c in calls]
    if to_close:
        out += ["", f"## To close: {len(to_close)} settled, not decisions (not calls; the order here is not recorded)", ""]
        for c in to_close:
            out.append(board_line(c))
            out += wrap(f"settled: {(c.get('evidence') or {}).get('settled_by', '')}", "    ")
    skipped = model.get("skipped") or []
    missing = [h["id"] for h in model.get("homes") or [] if h.get("status_log") != "read"]
    if skipped or missing:
        out += ["", "## Not calls now", ""]
        out += [l for s in skipped for l in wrap(f"{s['key']}: {s['why']}", "  ", "    ")]
        if missing:
            out += wrap("No status log read for: " + ", ".join(missing), "  ", "    ")
    return out


def render_card(card: dict, settled: bool) -> list[str]:
    """One card file: the question first, then context, options, links, answer area."""
    kind = "decision" if card.get("decision") else "not a decision (merge ask or review)"
    out = [
        f"Card {card['key']}   From: {origin(card)}" + (f"   Repo: {card['repo']}" if card.get("repo") else ""),
        "Write your answer at the bottom. A letter on its own, like  b , picks that option.",
        "Opened from the board in a tab: :wq (or :q) closes this tab and returns to the board.",
        "Opened on its own: save and quit with :wq",
        "",
    ]
    if settled:
        ev = card.get("evidence") or {}
        out += ["SETTLED - TO CLOSE, NOT A CALL. Nothing here closes it.", ""]
        out += wrap(f"Settled by: {ev.get('settled_by', '')}") + wrap(f"Evidence: {ev.get('text', '')}")
        out += ["Close with:", f"  {card.get('close_with', '')}", ""]
    out += [f"## {headline(card)}", ""]
    if headline(card) != re.sub(r"\s+", " ", question(card)).strip():
        out += wrap(question(card)) + [""]
    if card.get("title") and card.get("title") not in (card.get("question"), card.get("decision_key")):
        out += wrap(f"About: {card['title']}")
    out.append(f"Kind: {kind}")
    if card.get("task") and card.get("task") != card["key"]:
        out.append(f"Task: {card['task']}")
    if card.get("decision_key"):
        out.append(f"Key: {card['decision_key']}")
    if card.get("raised_at"):
        out.append(f"Raised: {card['raised_at']}")
    if card.get("blocked_by"):
        out += wrap("Waiting on: " + ", ".join(card["blocked_by"]))
    out.append("")
    options = card.get("options") or []
    if options:
        out.append("Options:")
        for letter, o in zip(LETTERS, options):
            out += wrap(f"{o.get('label')}", f"  {letter}) ", "     ")
        out.append("")
    states = {p["url"]: p["state"] for p in card.get("prs") or []}
    links = card.get("links") or []
    if links:
        out.append("Links:")
        for link in links:
            state = f"  ({states[link['url']]})" if link.get("url") in states else ""
            out.append(f"  {link.get('label') or 'link'}: {link.get('url')}{state}")
        out.append("")
    out += ["Your answer (write below this line):", "", ""]
    return out


def added_lines(before: list[str], after: list[str]) -> list[str]:
    sm = difflib.SequenceMatcher(a=before, b=after, autojunk=False)
    return [l for tag, _, _, j1, j2 in sm.get_opcodes() if tag in ("insert", "replace") for l in after[j1:j2]]


def interpret(card: dict, text_lines: list[str]) -> dict | None:
    text = "\n".join(text_lines).strip()
    if not text:
        return None
    options = card.get("options") or []
    record = {"kind": "answer", "key": card["key"], "home": card.get("home"), "task": card.get("task"),
              "decision_key": card.get("decision_key"), "question": headline(card, 300), "text": text}
    # "b", "b)", "b." or "b, but ..." picks b; a sentence that starts "A worker ..." does not.
    m = re.match(r"^\s*\(?([a-z])(?:\)|[.:,]|\s*$)", text, re.I)
    if m and LETTERS.index(m.group(1).lower()) < len(options):
        o = options[LETTERS.index(m.group(1).lower())]
        record["option"] = o.get("value")
        record["option_label"] = o.get("label")
    return record


def write_lines(path: Path, lines: list[str]) -> None:
    path.write_text("\n".join(lines) + "\n")


def main(argv: list[str]) -> int:
    if len(argv) > 1 or (argv and argv[0] in ("-h", "--help")):
        print(__doc__.strip().split("\n\n")[1])
        return 0 if argv and argv[0] in ("-h", "--help") else 2
    model = load_model()
    calls, to_close = list(model.get("calls") or []), list(model.get("to_close") or [])
    cards = calls + to_close
    if not cards:
        print("No captain calls and nothing to close; nothing to answer.")
        return 0
    if argv and argv[0] not in {c["key"] for c in cards}:
        print(f"No card with key {argv[0]!r}. Cards now:", file=sys.stderr)
        for c in cards:
            print(f"  {c['key']}", file=sys.stderr)
        return 2

    # A fresh board folder every run (prototype/board/ is this script's own scratch folder).
    settled = {c["key"] for c in to_close}
    board_before = render_board(model)
    card_before = {c["key"]: render_card(c, c["key"] in settled) for c in cards}
    if BOARD.exists():
        shutil.rmtree(BOARD)
    (BOARD / "cards").mkdir(parents=True)
    write_lines(BOARD / "board.md", board_before)
    for key, lines in card_before.items():
        write_lines(BOARD / "cards" / f"{key}.md", lines)

    # Run from the board folder so cards/<key>.md resolves for gf and the editor's own paths.
    target = f"cards/{argv[0]}.md" if argv else "board.md"
    editor = shlex.split(os.environ.get("EDITOR") or "nvim")
    if not argv and Path(editor[0]).name in ("nvim", "vim"):
        # A buffer-local mapping on board.md only (a modeline cannot map keys):
        # gf and Enter open the card named on the line in a new tab; a line with no card does nothing.
        open_card = ("nnoremap <buffer> <silent> gf <Cmd>let b:fm_card = matchstr(getline('.'), 'cards/[^ )]\\+\\.md')"
                     "<Bar>if b:fm_card != ''<Bar>exe 'tabedit' fnameescape(b:fm_card)<Bar>endif<CR>")
        editor += ["-c", open_card, "-c", "nmap <buffer> <CR> gf"]
    rc = subprocess.run(editor + [target], cwd=BOARD).returncode
    if rc != 0:
        print(f"The editor exited with status {rc}; nothing written. The board is left in {BOARD} until the next run.")
        return 1

    records: list[dict] = []
    board_after = (BOARD / "board.md").read_text().splitlines()
    original = [c["key"] for c in calls]
    order = [m.group(1) for l in board_after if (m := CARD_LINE.search(l)) and m.group(1) in original]
    order = list(dict.fromkeys(order))
    if order != original:
        rec = {"kind": "order", "keys": order}
        if missing := [k for k in original if k not in order]:
            rec["missing"] = missing
        records.append(rec)
    stray = [l for l in added_lines(board_before, board_after)
             if l.strip() and not CARD_LINE.search(l) and l not in board_before]
    for c in cards:
        path = BOARD / "cards" / f"{c['key']}.md"
        if path.exists() and (r := interpret(c, added_lines(card_before[c["key"]], path.read_text().splitlines()))):
            if c["key"] in settled:
                r["settled"] = True
            records.append(r)

    if stray:
        print("Ignored text written in board.md (answers go in the card files):")
        for l in stray:
            print(f"  {l}")
    if not records:
        print("No new order and no answers; nothing captured.")
        return 0
    at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    OUTBOX.parent.mkdir(parents=True, exist_ok=True)
    with OUTBOX.open("a") as f:
        for r in records:
            f.write(json.dumps({"at": at, "prototype": True, **r}) + "\n")
    print(f"Captured into {OUTBOX}:")
    for r in records:
        if r["kind"] == "order":
            print("  new order:")
            for i, k in enumerate(r["keys"], 1):
                print(f"    {i}. {k}")
            for k in r.get("missing", []):
                print(f"    (line removed: {k})")
            continue
        pick = f" picked {r['option_label']!r}" if "option" in r else ""
        print(f"  answer for {r['key']}:{pick}")
        for line in r["text"].splitlines():
            print(f"    | {line}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
